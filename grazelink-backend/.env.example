# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API from a browser
# (your Vite dev server, and later your production dashboard domain).
CORS_ORIGINS=http://localhost:5173

# Firebase Admin credentials
# ------------------------------------------------------------------
# Firebase console → Project settings → Service accounts →
# "Generate new private key". Downloads a JSON file — DO NOT commit it.
#
# Option A (recommended for local dev): save the file as
# serviceAccountKey.json in this folder and set the path below.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# Option B (recommended for deployment — no file on disk): paste the
# entire JSON file contents as a single-line string here instead, and
# leave FIREBASE_SERVICE_ACCOUNT_PATH blank.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Rate limiting for the device upload endpoint
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=30
