rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User farm profiles
    match /farms/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Per-farm settings (geofence safe zone), keyed by the farm's own uid.
    // src/hooks/useFarmGeofence.ts subscribes to and writes this document;
    // without a rule it fell under the default deny, so saving a safe zone
    // failed and the map silently fell back to its localStorage default.
    // The ingestion API reads it through the Admin SDK, which bypasses rules.
    match /farmSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Top-level Livestock collection
    match /livestock/{livestockId} {
      allow read, write: if request.auth != null && resource.data.farmUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.farmUid == request.auth.uid;
    }

    // Devices collection
    match /devices/{deviceId} {
      allow read, write: if request.auth != null && resource.data.farmUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.farmUid == request.auth.uid;
    }

    // GPS History collection
    match /gpsHistory/{historyId} {
      allow read: if request.auth != null && resource.data.farmUid == request.auth.uid;
      allow write: if request.auth != null && resource.data.farmUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.farmUid == request.auth.uid;
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read, write: if request.auth != null && resource.data.farmUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.farmUid == request.auth.uid;
    }
  }
}
