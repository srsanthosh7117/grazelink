# Firebase project config — copy to .env and fill in real values.
# These must also be set as environment variables in the Netlify deploy.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: set this to enable App Check enforcement on Firestore.
# Create a reCAPTCHA (Enterprise) site key in Firebase console → App Check,
# then set this var and redeploy. While unset, App Check is compiled out of
# the bundle and the app runs without it.
VITE_RECAPTCHA_SITE_KEY=
