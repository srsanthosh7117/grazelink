PORT=5000
FIREBASE_PROJECT_ID=dashboard-47a1c
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@dashboard-47a1c.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Per-device API keys (recommended): each collar gets its own key,
# generated automatically when it's registered in the dashboard
# (Devices page -> Register ESP32 Device). No configuration needed here.

# Legacy fallback only — lets collars flashed before per-device keys
# existed keep working. Leave unset once all devices are migrated.
DEVICE_API_KEY=

# Local development only: set to "true" to skip device auth entirely
# against un-provisioned test devices. Never honored when NODE_ENV=production.
SKIP_DEVICE_AUTH=false
